{
  "name": "soroagent",
  "version": "2.34.0",
  "private": true,
  "description": "soroagent: an AI assistant for any web page, powered by a local LLM or your own API key.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "package": "node scripts/build.mjs --zip",
    "downloads": "node scripts/build.mjs --downloads",
    "release": "node scripts/release.mjs",
    "store": "node scripts/build.mjs --store --zip",
    "icons": "node scripts/make-icons.mjs",
    "try-prompt": "node scripts/try-prompt.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check"
  },
  "license": "MIT"
}

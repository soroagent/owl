{
  "manifest_version": 3,
  "name": "soroagent",
  "short_name": "soroagent",
  "version": "2.41.0",
  "description": "Summarize, ask about and save any web page or PDF into a private library, using AI on your computer, in the browser or your own key.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "downloads",
    "alarms",
    "identity",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background/sw.js",
    "scripts": [
      "shared/config.js",
      "background/flight.js",
      "shared/markdown.js",
      "shared/prompts.js",
      "shared/snippets.js",
      "shared/knowledge.js",
      "shared/backup.js",
      "background/autobackup.js",
      "background/sync.js",
      "background/mdexport.js",
      "background/llm.js",
      "background/browserai.js",
      "background/pdfread.js",
      "background/recommend.js",
      "background/secrets.js",
      "background/research.js",
      "background/library.js",
      "background/jobs.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/config.js",
        "shared/markdown.js",
        "shared/prompts.js",
        "shared/templates.js",
        "prompts/*.js",
        "shared/snippets.js",
        "shared/knowledge.js",
        "sites/registry.js",
        "sites/*.js",
        "vendor/readability/Readability.js",
        "content/extract.js",
        "shared/brand.js",
        "content/styles.js",
        "content/launcher.js",
        "content/capture.js",
        "content/faq.js",
        "content/assistant.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open soroagent (Alt+Shift+O)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "commands": {
    "open-soroagent": {
      "suggested_key": {
        "default": "Alt+Shift+O",
        "mac": "Alt+Shift+O"
      },
      "description": "Open soroagent (side panel, or the panel on the page if you chose that)"
    },
    "toggle-assistant": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open or close the floating panel on the current page"
    }
  },
  "side_panel": {
    "default_path": "pages/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sorotrack@arjunmarri.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pages/onboard.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
